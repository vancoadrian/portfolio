# Binary image assets go through Git LFS from here on to keep repo clones
# small. Existing history is untouched (no rewrite) - this only applies to
# new commits.
public/**/*.png filter=lfs diff=lfs merge=lfs -text
public/**/*.jpg filter=lfs diff=lfs merge=lfs -text
public/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
public/**/*.webp filter=lfs diff=lfs merge=lfs -text
public/**/*.gif filter=lfs diff=lfs merge=lfs -text
